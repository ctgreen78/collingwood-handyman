---
// FAQs. Questions from the live page. Answers rewritten from confirmed facts only (no payment
// methods question: not confirmed).
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import Faq from '../components/Faq.astro';
import QuoteBand from '../components/QuoteBand.astro';
import { business, webPage, breadcrumbs, faqPage } from '../lib/schema.js';
const meta = { path: '/faqs', title: 'FAQs | Collingwood Handyman', description: 'Answers about Collingwood Handyman: how requests work, services, service areas, quotes, licensed trades and materials. Call 705-795-4009 with a question.' };
const crumbs = [{ name: 'Home', href: '/' }, { name: 'FAQs', href: '/faqs' }];
const faqs = [
  { q: 'What handyman services can I request?', a: 'You can request home repairs, bathroom and kitchen updates, basements, flooring, tile, drywall, carpentry, painting, decks, fences, pressure washing, property maintenance and cottage opening, closing and upkeep. The services page lists every one.' },
  { q: 'What areas does this website cover?', a: 'Requests are taken for Collingwood, Wasaga Beach, Stayner, Elmvale, Barrie, Innisfil, Orillia, New Tecumseth and Oro-Medonte, plus nearby cottage country. A service provider confirms coverage for your address when you send your request.' },
  { q: 'How is the price of a job worked out?', a: 'Each job is quoted on its own scope, materials and the condition of the space. Send clear details and photos so the service provider can discuss the scope and a quote with you.' },
  { q: 'How do I send a request?', a: 'Call 705-795-4009 or send the quote form with a short description, your town or postcode and photos. A local service provider reviews the request and contacts you about next steps.' },
  { q: 'How soon can work start?', a: 'Timing depends on the job and the service provider schedule. Say in your request if the work is urgent or tied to a date, such as a cottage opening.' },
  { q: 'Who does the work?', a: 'Collingwood Handyman is an enquiry website. It passes your request to a local service provider, who reviews it and contacts you. Ask the service provider about their insurance, warranty and terms before work starts.' },
  { q: 'What about electrical, plumbing or gas work?', a: 'In Ontario some electrical, plumbing and gas work must be done by a licensed contractor. Mention these items in your request and the service provider can confirm what applies.' },
  { q: 'Who supplies the materials?', a: 'It depends on the job. Some homeowners buy their own finishes such as tile, fixtures or paint. Say what you plan in your request and agree it with the service provider before work starts.' },
  { q: 'Should I hire a pro or do it myself?', a: 'Small cosmetic jobs are often fine to do yourself. Anything involving water, structure, height, or electrical and gas work is worth a professional look, because mistakes there cost more to fix later.' },
];
---
<Layout {...meta} schemas={[business(), webPage(meta), breadcrumbs(crumbs), faqPage(faqs)]}>
  <PageHead crumbs={crumbs} eyebrow="FAQs" title="Frequently asked&nbsp;questions." sub="Quick answers about how requests work, services, areas and quotes." actions={false} />
  <div class="fq"><Faq title="Common questions" faqs={faqs} openFirst={false} /></div>
  <QuoteBand heading="Still have a question?" sub="Call or send a message with your question and the details of the job." />
</Layout>
<style>
  .fq :global(.faq__in) { max-width: 52rem; }
  .fq :global(.faq__head) { display: none; }
</style>
