---
// Shown after a form is sent without JavaScript (functions/api/lead.js redirects here).
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import { site } from '../data/site.js';
const meta = { path: '/thanks', title: 'Thanks | Collingwood Handyman', description: 'Your request was sent.' };
---
<Layout {...meta} indexing="noindex,nofollow">
  <PageHead eyebrow="Request sent" title="Thanks. Your request is on its&nbsp;way." sub={`Keith will review it and get back to you. For anything urgent, call ${site.phone}.`} actions={false} />
  <section class="section"><div class="wrap"><a class="btn btn--quote" href="/">Back to the home page</a></div></section>
</Layout>
