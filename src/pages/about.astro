---
// About this website. Rank-and-rent enquiry brand (Chris, 2026-11-26): no owner, credentials or reviews.
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import TownsBand from '../components/TownsBand.astro';
import QuoteBand from '../components/QuoteBand.astro';
import Icon from '../components/Icon.astro';
import { serviceGroups } from '../data/site.js';
import { business, webPage, breadcrumbs } from '../lib/schema.js';

const meta = { path: '/about', title: 'About This Website | Collingwood Handyman', description: 'How Collingwood Handyman works: describe the job, share your town and a local service provider reviews your request for homes and cottages near Collingwood.' };
const crumbs = [{ name: 'Home', href: '/' }, { name: 'How it works', href: '/about' }];
const values = [
  { icon: 'file-text', title: 'Describe the job', body: 'Say what needs doing, the rough size of the job and any timing needs.' },
  { icon: 'map-pin', title: 'Share your town', body: 'Your town or postcode lets the service provider confirm coverage for your address.' },
  { icon: 'camera', title: 'Add photos', body: 'Photos close up and from a distance help the service provider understand the scope.' },
  { icon: 'phone', title: 'Talk it through', body: 'The service provider contacts you to discuss scope, a quote and next steps.' },
];
const aboutPage = { ...webPage(meta), '@type': 'AboutPage' };
---
<Layout {...meta} schemas={[business(), aboutPage, breadcrumbs(crumbs)]}>
  <Hero crumbs={crumbs} eyebrow="About this website" title="A simple way to request handyman&nbsp;work." sub="Collingwood Handyman is an enquiry website for homes, cottages and rentals around Collingwood and the southern Georgian Bay." panel={{ icon: 'hammer', heading: 'How a request works' }} />
  <TrustStrip />

  <section class="section story">
    <div class="wrap story__in">
      <div>
        <h2>How this website works.</h2>
        <p>Collingwood Handyman connects requests for handyman work in Collingwood and nearby towns with a local service provider who reviews each request.</p>
        <p>You describe the work, add your location and send the form or call. The service provider reviews the details, confirms coverage for your address and contacts you to discuss scope and next steps.</p>
        <p>The service pages explain common jobs, what affects scope and which details help. They are a guide to writing a clear request, not a promise of price or timing.</p>
      </div>
      <div class="story__quote">
        <h3>Good to know</h3>
        <ul class="story__list">
          <li><Icon name="check" size={20} stroke={2.5} />Requests are reviewed by a local service provider.</li>
          <li><Icon name="check" size={20} stroke={2.5} />Coverage is confirmed for your address when you send your request.</li>
          <li><Icon name="check" size={20} stroke={2.5} />Ask the service provider about insurance, warranty and terms before work starts.</li>
          <li><Icon name="check" size={20} stroke={2.5} />No reviews are shown until verified ones are available.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--cream vals" aria-labelledby="vals-h">
    <div class="wrap">
      <h2 id="vals-h" class="center">What makes a clear request</h2>
      <ul class="vals__grid">
        {values.map((v) => <li><Icon name={v.icon} size={36} stroke={1.5} /><h3>{v.title}</h3><p>{v.body}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="section exp" aria-labelledby="exp-h">
    <div class="wrap">
      <h2 id="exp-h">What you can request</h2>
      <ul class="exp__grid">
        {serviceGroups.map((g) => <li><a href={`/services#${g.id}`}><Icon name={g.icon} size={28} stroke={1.5} /><span><strong>{g.title}</strong><span>{g.blurb}</span></span></a></li>)}
      </ul>
      <p class="muted exp__note">In Ontario some electrical, plumbing and gas work must be done by a licensed contractor. The service provider can confirm what applies to your job.</p>
    </div>
  </section>

  <TownsBand heading="Here for your home. And your place away from&nbsp;home." />
  <QuoteBand heading="Tell us what needs doing." sub="Share the job and your location so a local service provider can review your request." />
</Layout>

<style>
  .story__in { display: grid; grid-template-columns: 1.4fr 1fr; gap: 4rem; align-items: center; }
  .story h2 { margin-bottom: 1rem; }
  .story p { color: var(--muted); }
  .story__quote { padding: 2rem; background: var(--cream); border-radius: var(--radius-lg); }
  .vals h2 { margin-bottom: 2rem; }
  .vals__grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem; }
  .vals__grid li { padding: 1.5rem; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); }
  .vals__grid :global(.icon) { color: var(--teal); margin-bottom: 0.75rem; }
  .vals__grid h3 { margin-bottom: 0.4rem; }
  .vals__grid p { margin: 0; font-size: 0.95rem; color: var(--muted); }
  .exp h2 { margin-bottom: 1.5rem; }
  .exp__grid { list-style: none; padding: 0; margin: 0 0 1.25rem; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .exp__grid a { display: flex; gap: 0.9rem; align-items: flex-start; height: 100%; padding: 1.1rem 1.2rem; border: 1px solid var(--line); border-radius: var(--radius); text-decoration: none; }
  .exp__grid a:hover { border-color: var(--teal-bright); }
  .exp__grid :global(.icon) { flex: none; color: var(--teal); }
  .exp__grid a > span { display: grid; gap: 0.2rem; }
  .exp__grid strong { font-weight: 800; }
  .exp__grid a > span > span { font-size: 0.9rem; color: var(--muted); }
  @media (max-width: 960px) { .vals__grid, .exp__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 860px) { .story__in { grid-template-columns: 1fr; gap: 2rem; } }
  @media (max-width: 560px) { .vals__grid, .exp__grid { grid-template-columns: 1fr; } }
  .story__quote h3 { font-size: 1.3rem; margin-bottom: 1rem; }
  .story__list { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.7rem; font-weight: 700; }
  .story__list li { display: flex; gap: 0.6rem; align-items: flex-start; }
  .story__list :global(.icon) { flex: none; color: var(--teal); margin-top: 0.1rem; }
</style>
