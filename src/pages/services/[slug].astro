---
// Builds every /services/<slug> page from src/data/content/services.json.
import ServicePage from '../../components/ServicePage.astro';
import { services } from '../../data/content.js';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;
---
<ServicePage s={s} />
