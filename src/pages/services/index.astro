---
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/PageHead.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import TownsBand from '../../components/TownsBand.astro';
import QuoteBand from '../../components/QuoteBand.astro';
import Icon from '../../components/Icon.astro';
import { serviceGroups } from '../../data/site.js';
import { serviceBySlug } from '../../data/content.js';
import { business, webPage, breadcrumbs } from '../../lib/schema.js';
const meta = { path: '/services', title: 'Handyman Services in Collingwood | Collingwood Handyman', description: 'Request a quote in Collingwood and nearby towns for home repairs, bathrooms, kitchens, decks, fences, painting and cottage care. Call or send the details.' };
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Services', href: '/services' }];
const blurb = (href) => serviceBySlug[href.split('/').pop()]?.sub ?? '';
---
<Layout {...meta} schemas={[business(), webPage(meta), breadcrumbs(crumbs)]}>
  <PageHead crumbs={crumbs} eyebrow="Collingwood & surrounding communities" title="Handyman services for homes and&nbsp;cottages." sub="Repairs, renovations and seasonal care, reviewed by a local service provider. Pick a service to see what it covers, or send your list as one request." />
  <TrustStrip />
  {serviceGroups.map((g, i) => (
    <section class:list={['section grp', { 'section--cream': i % 2 === 1 }]} id={g.id} aria-labelledby={`${g.id}-h`}>
      <div class="wrap">
        <div class="grp__head"><Icon name={g.icon} size={40} stroke={1.5} /><div><h2 id={`${g.id}-h`}>{g.title}</h2><p class="muted">{g.blurb}</p></div></div>
        <ul class="grp__grid">
          {g.services.map(([name, href]) => (
            <li><a href={href}><strong>{name}</strong><span>{blurb(href)}</span><Icon name="arrow-right" size={18} stroke={2.25} class="grp__arrow" /></a></li>
          ))}
        </ul>
      </div>
    </section>
  ))}
  <TownsBand heading="Requests welcome from Collingwood, Wasaga Beach, Stayner and nearby communities." towns={false} />
  <QuoteBand heading="Let’s talk about your project." sub="Describe what needs doing and where. A local service provider will review your request." />
</Layout>
<style>
  .grp { scroll-margin-top: 5rem; }
  .grp__head { display: flex; gap: 1.25rem; align-items: flex-start; margin-bottom: 1.5rem; }
  .grp__head > :global(.icon) { flex: none; color: var(--teal); margin-top: 0.2rem; }
  .grp__head p { margin: 0.35rem 0 0; }
  .grp__grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .grp__grid a { position: relative; display: grid; gap: 0.35rem; align-content: start; height: 100%; padding: 1.2rem 2.75rem 1.2rem 1.25rem; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); text-decoration: none; box-shadow: var(--shadow); transition: transform 0.2s ease, border-color 0.2s ease; }
  .grp__grid a:hover { transform: translateY(-2px); border-color: var(--teal-bright); }
  .grp__grid strong { font-weight: 800; font-size: 1.08rem; }
  .grp__grid span { font-size: 0.9rem; color: var(--muted); }
  .grp__grid :global(.grp__arrow) { position: absolute; right: 1rem; top: 1.3rem; color: var(--teal); }
  @media (max-width: 960px) { .grp__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .grp__grid { grid-template-columns: 1fr; } }
</style>
