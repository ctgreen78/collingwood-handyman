---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import QuoteBand from '../components/QuoteBand.astro';
import ClaimsCard from '../components/ClaimsCard.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site.js';
import { business, webPage, breadcrumbs } from '../lib/schema.js';
const meta = { path: '/contact', title: 'Contact Collingwood Handyman | Free Estimates', description: 'Call Keith Diver at 705-795-4009 or send your project details for a free estimate. Collingwood Handyman, 4-115 First St, Collingwood. Mon to Sat, 8am to 6pm.' };
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Contact', href: '/contact' }];
const rows = [
  { icon: 'phone', label: 'Phone', value: site.phone, href: `tel:${site.phoneHref}` },
  { icon: 'mail', label: 'Email', value: site.email, href: `mailto:${site.email}` },
  { icon: 'map-pin', label: 'Address', value: `${site.address.street}, ${site.address.city} ${site.address.region} ${site.address.postal}` },
  { icon: 'clock', label: 'Hours', value: site.hours },
];
---
<Layout {...meta} schemas={[business(), webPage(meta), breadcrumbs(crumbs)]}>
  <PageHead crumbs={crumbs} eyebrow="Contact" title="Let’s talk about your&nbsp;project." sub="Call Keith, or send the details below for a free, no-obligation estimate. Photos and measurements help." />
  <section class="section">
    <div class="wrap ct">
      <ul class="ct__list">
        {rows.map((r) => (
          <li><Icon name={r.icon} size={24} stroke={1.75} /><span><strong>{r.label}</strong>{r.href ? <a href={r.href}>{r.value}</a> : <span>{r.value}</span>}</span></li>
        ))}
      </ul>
      <div class="ct__card"><ClaimsCard /></div>
    </div>
  </section>
  <QuoteBand heading="Send your project details." sub="Keith reviews every request and replies to arrange the next step." />
</Layout>
<style>
  .ct { display: grid; grid-template-columns: 1.2fr 1fr; gap: 3rem; align-items: start; }
  .ct__list { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.25rem; }
  .ct__list li { display: flex; gap: 1rem; align-items: flex-start; padding-bottom: 1.25rem; border-bottom: 1px solid var(--line); }
  .ct__list :global(.icon) { flex: none; color: var(--teal); margin-top: 0.15rem; }
  .ct__list li > span { display: grid; gap: 0.15rem; }
  .ct__list strong { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
  .ct__list a, .ct__list li > span > span { font-size: 1.15rem; font-weight: 700; }
  .ct__list a { color: var(--teal); text-decoration: none; }
  .ct__list a:hover { text-decoration: underline; }
  .ct__card { padding: 2rem; background: var(--cream); border-radius: var(--radius-lg); }
  @media (max-width: 860px) { .ct { grid-template-columns: 1fr; gap: 2rem; } }
</style>
