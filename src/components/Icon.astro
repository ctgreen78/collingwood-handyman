---
// Inline Lucide icon (one consistent line-icon family, ISC licence).
// Decorative by default: the text next to the icon carries the meaning.
import fs from 'node:fs';
import path from 'node:path';
const { name, size = 24, stroke = 1.75, class: cls = '' } = Astro.props;
const file = path.join(process.cwd(), 'node_modules', 'lucide-static', 'icons', `${name}.svg`);
let svg = fs.readFileSync(file, 'utf8').replace(/<!--.*?-->/s, '').trim();
svg = svg
  .replace(/class="[^"]*"/, `class="icon ${cls}" aria-hidden="true" focusable="false"`)
  .replace(/width="24"/, `width="${size}"`)
  .replace(/height="24"/, `height="${size}"`)
  .replace(/stroke-width="2"/, `stroke-width="${stroke}"`);
---
<Fragment set:html={svg} />
