---
// Simple cream page header for hubs and info pages: crumbs, eyebrow, H1, intro and optional actions.
import Icon from './Icon.astro';
import { site } from '../data/site.js';
const { crumbs = null, eyebrow, title, sub = null, actions = true } = Astro.props;
---
<section class="ph">
  <div class="wrap">
    {crumbs && (
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>{crumbs.map((c, i) => <li>{i < crumbs.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>)}</ol>
      </nav>
    )}
    <p class="eyebrow">{eyebrow}</p>
    <h1 set:html={title} />
    {sub && <p class="lede">{sub}</p>}
    {actions && (
      <div class="ph__ctas">
        <a class="btn btn--quote" href="#quote">Request a Quote</a>
        <a class="btn btn--outline" href={`tel:${site.phoneHref}`}><Icon name="phone" size={18} stroke={2.25} />{site.phone}</a>
      </div>
    )}
  </div>
</section>

<style>
  .ph { background: var(--cream); padding-block: 2.5rem 3rem; }
  .ph h1 { max-width: 20ch; margin-bottom: 1rem; font-size: clamp(2.2rem, 4.4vw, 3.25rem); }
  .ph .lede { max-width: 42rem; margin-bottom: 1.5rem; }
  .ph__ctas { display: flex; flex-wrap: wrap; gap: 0.85rem; }
  .crumbs ol { list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem; padding: 0; margin: 0 0 1.5rem; font-size: 0.88rem; }
  .crumbs li + li::before { content: '/'; margin-right: 0.4rem; color: var(--muted); }
  .crumbs a { text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  .crumbs [aria-current] { color: var(--teal); font-weight: 700; }
  @media (max-width: 860px) { .ph__ctas .btn--outline { display: none; } .ph__ctas .btn--quote { flex: 1 1 100%; } }
</style>
