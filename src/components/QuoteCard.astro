---
// One customer quote. Only Mike's quote is published until Keith confirms the other reviews.
const { text = 'Professional, clean, and finished on time.', name = 'Mike', context = null, link = true } = Astro.props;
import Icon from './Icon.astro';
---
<figure class="qc">
  <blockquote>“{text}”</blockquote>
  <figcaption>
    <span>{name} · Published on this website</span>
    {context && <strong>{context}</strong>}
  </figcaption>
  {link && <a class="text-link" href="/reviews">Read customer reviews <Icon name="arrow-right" size={18} stroke={2.25} /></a>}
</figure>

<style>
  .qc { margin: 0; padding-left: 1.5rem; border-left: 3px solid var(--teal-bright); }
  .qc blockquote { margin: 0 0 0.75rem; font-size: 1.35rem; font-weight: 700; font-style: italic; line-height: 1.3; letter-spacing: -0.01em; }
  .qc figcaption { display: grid; gap: 0.6rem; margin-bottom: 0.9rem; font-size: 0.92rem; }
  .qc figcaption strong { font-size: 0.98rem; }
</style>
