---
// Navy footer (mockup A): logo card, brand, links, phone, contact details. No owner or street address.
import { Image } from 'astro:assets';
import logo from '../assets/collingwood-handyman-logo.png';
import Icon from './Icon.astro';
import { site, serviceGroups, areas } from '../data/site.js';
const year = new Date().getFullYear();
---
<footer class="ftr">
  <div class="wrap ftr__top">
    <a class="ftr__logo" href="/" aria-label={`${site.name} home`}>
      <Image src={logo} alt="" width={360} widths={[180, 360]} sizes="180px" />
    </a>
    <div class="ftr__id">
      <strong>{site.name}</strong>
      <span>{site.region}</span>
    </div>
    <nav class="ftr__nav" aria-label="Footer">
      <a href="/services">Services</a>
      <a href="/about">About</a>
      <a href="/faqs">FAQs</a>
      <a href="/contact">Contact</a>
      <a href="/privacy-policy">Privacy</a>
    </nav>
    <a class="ftr__phone" href={`tel:${site.phoneHref}`}>{site.phone}</a>
  </div>

  <div class="wrap ftr__cols">
    <div>
      <h2 class="ftr__h">Popular services</h2>
      <ul>{serviceGroups.slice(0, 5).map((g) => <li><a href={`/services#${g.id}`}>{g.title}</a></li>)}</ul>
    </div>
    <div>
      <h2 class="ftr__h">Service areas</h2>
      <ul class="ftr__areas">{areas.map(([n, h]) => <li><a href={h}>{n}</a></li>)}</ul>
    </div>
    <div>
      <h2 class="ftr__h">Contact</h2>
      <ul class="ftr__contact">
        <li><Icon name="phone" size={16} stroke={2} /><a href={`tel:${site.phoneHref}`}>{site.phone}</a></li>
        <li><Icon name="mail" size={16} stroke={2} /><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><Icon name="map-pin" size={16} stroke={2} /><span>Collingwood and nearby towns</span></li>
      </ul>
    </div>
  </div>

  <div class="wrap ftr__credit">
    <p>&copy; {year} {site.name}. Requests are reviewed by a local service provider.</p>
    <p>Website built and managed by <a href="https://certtechweb.com/">certtechweb.com</a></p>
  </div>
</footer>

<style>
  .ftr { background: var(--navy); color: #fff; padding-block: 2rem 1.5rem; font-size: 0.9rem; }
  .ftr a { color: #fff; text-decoration: none; }
  .ftr a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .ftr__top { display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem 2rem; padding-bottom: 1.75rem; border-bottom: 1px solid rgba(255, 255, 255, 0.14); }
  .ftr__logo { display: block; width: 210px; padding: 0.75rem 1rem; background: #fff; border-radius: var(--radius); }
  .ftr__id { display: grid; padding-left: 2rem; border-left: 1px solid rgba(255, 255, 255, 0.25); line-height: 1.35; }
  .ftr__id span { opacity: 0.75; font-size: 0.85rem; }
  .ftr__nav { display: flex; flex-wrap: wrap; gap: 0.5rem 1.75rem; padding-left: 2rem; border-left: 1px solid rgba(255, 255, 255, 0.25); }
  .ftr__phone { margin-left: auto; padding-left: 2rem; border-left: 1px solid rgba(255, 255, 255, 0.25); font-weight: 800; font-size: 1.05rem; white-space: nowrap; }
  .ftr__cols { display: grid; grid-template-columns: 1fr 1.3fr 1.4fr; gap: 2rem; padding-block: 1.75rem; }
  .ftr__h { font-size: 0.8rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #9fd6e6; margin-bottom: 0.6rem; }
  .ftr ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.35rem; }
  .ftr__areas { grid-template-columns: 1fr 1fr; column-gap: 1rem; }
  .ftr__contact li { display: flex; align-items: flex-start; gap: 0.55rem; }
  .ftr__contact :global(.icon) { flex: none; margin-top: 0.2rem; color: #9fd6e6; }
  .ftr__credit { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 2rem; padding-top: 1.25rem; border-top: 1px solid rgba(255, 255, 255, 0.14); font-size: 0.8rem; opacity: 0.85; }
  .ftr__credit p { margin: 0; }
  .ftr__credit a { color: #9fd6e6; font-weight: 700; }
  @media (max-width: 980px) {
    .ftr__phone { margin-left: 0; }
    .ftr__id, .ftr__nav, .ftr__phone { padding-left: 0; border-left: 0; }
    .ftr__top { flex-direction: column; align-items: flex-start; }
    .ftr__cols { grid-template-columns: 1fr; gap: 1.5rem; }
  }
</style>
