---
// Google Analytics 4 (Chris 2026-11-26). Loads only on the real domain, never on the
// pages.dev test link or local dev, and never while site.preview is on.
// The privacy page describes it. The quote form sends a generate_lead event (no personal details).
// Speed (2026-11-27): gtag.js is about 180 KB and was the main cause of slow mobile scores.
// It now loads on the visitor's first scroll, tap or key press, or 4 seconds after the page loads.
// The gtag() queue is set up at once, so events sent before the script arrives are kept.
import { site } from '../data/site.js';
const id = site.ga4;
const host = new URL(site.url).hostname;
const on = Boolean(id) && !site.preview;
---
{on && (
  <script is:inline define:vars={{ id, host }}>
    if (location.hostname === host || location.hostname === 'www.' + host) {
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag('js', new Date());
      window.gtag('config', id);
      var done = false;
      var evs = ['scroll', 'pointerdown', 'keydown', 'touchstart'];
      var load = function () {
        if (done) return;
        done = true;
        evs.forEach(function (e) { removeEventListener(e, load); });
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + id;
        document.head.appendChild(s);
      };
      evs.forEach(function (e) { addEventListener(e, load, { once: true, passive: true }); });
      addEventListener('load', function () { setTimeout(load, 4000); });
    }
  </script>
)}
