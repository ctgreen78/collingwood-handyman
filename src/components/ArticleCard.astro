---
// Article card for the blog and insights hubs and the related list.
import Icon from './Icon.astro';
import { articleUrl, excerpt } from '../data/content.js';
const { a, h = 'h2' } = Astro.props;
const H = h;
const date = (a.dateModified || a.datePublished || '').slice(0, 10);
const nice = date ? new Date(date + 'T12:00:00Z').toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }) : '';
---
<article class="ac">
  <a href={articleUrl(a)}>
    {nice && <time datetime={date}>{nice}</time>}
    <H class="ac__h">{a.title}</H>
    <p>{excerpt(a)}</p>
    <span class="ac__more">Read the article <Icon name="arrow-right" size={16} stroke={2.25} /></span>
  </a>
</article>

<style>
  .ac a { display: grid; gap: 0.5rem; height: 100%; padding: 1.4rem; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); text-decoration: none; box-shadow: var(--shadow); transition: transform 0.2s ease, border-color 0.2s ease; }
  .ac a:hover { transform: translateY(-3px); border-color: var(--teal-bright); }
  .ac time { font-size: 0.8rem; font-weight: 700; color: var(--teal); text-transform: uppercase; letter-spacing: 0.05em; }
  .ac__h { font-size: 1.15rem; line-height: 1.25; letter-spacing: -0.015em; }
  .ac p { margin: 0; font-size: 0.93rem; color: var(--muted); }
  .ac__more { display: inline-flex; align-items: center; gap: 0.35rem; margin-top: auto; font-weight: 800; font-size: 0.9rem; color: var(--teal); }
</style>
